{
  "manifest_version": 3,
  "name": "__MSG_appName__",
  "version": "2.30.0",
  "default_locale": "en",
  "description": "__MSG_appDesc__",
  "permissions": [
    "tabs",
    "storage",
    "webNavigation",
    "scripting",
    "alarms",
    "notifications",
    "identity",
    "sidePanel"
  ],
  "host_permissions": [
    "*://*.youtube.com/*"
  ],
  "optional_permissions": [
    "history"
  ],
  "optional_host_permissions": [
    "https://mail.google.com/*",
    "https://claude.ai/*",
    "https://chatgpt.com/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "__MSG_actionTitle__"
  },
  "side_panel": {
    "default_path": "popup.html?panel=1"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "minimum_chrome_version": "116"
}
